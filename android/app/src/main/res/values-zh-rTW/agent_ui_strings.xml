    <string name="agent_view_renderer" tools:machine_translated="true">渲染器</string>
    <!-- 說明 TUI 會在終端機中以獨立的 SSH 會話執行。 -->
    <string name="agent_tui_notice" tools:machine_translated="true">TUI 會以獨立的 SSH 會話在終端機中開啟，使用本會話的 Agent 與工作目錄。</string>
    <!-- 提醒本對話的 ACP 處理程序可能保持同一會話開啟。 -->
    <string name="agent_tui_share_warning" tools:machine_translated="true">本對話目前由 ACP 處理程序佔用同一會話 ID。同一會話上 ACP 與互動式 TUI 能否並行尚未驗證；如 TUI 無法開啟，請先關閉對話再試。</string>
    <!-- 開啟互動式 TUI 的確切 shell 指令標籤。 -->
    <string name="agent_tui_command" tools:machine_translated="true">指令</string>
    <!-- 開啟終端機並傳送 TUI 指令的操作。 -->
    <string name="agent_tui_open" tools:machine_translated="true">開啟終端機</string>
    <!-- 說明開啟 TUI 前需要可用的 SSH 主機。 -->
    <string name="agent_tui_no_host" tools:machine_translated="true">此會話所屬主機無法使用，無法開啟終端機。</string>
    <!-- 說明該工作目錄無法用作終端機參數。 -->
    <string name="agent_tui_bad_cwd" tools:machine_translated="true">此會話的工作目錄無法使用，拒絕拼接終端機指令。</string>
    <!-- 探測仍在進行：新結論傳回前不顯示上一次的結論。 -->
    <string name="agent_probe_refreshing" tools:machine_translated="true">正在探測…</string>
    <!-- 探測結論：主機上沒有該 Agent 的安裝。 -->
    <string name="agent_probe_not_installed" tools:machine_translated="true">未安裝：主機上找不到該 Agent 的執行檔。</string>
    <!-- 探測結論：找到了 Agent，但它未能完成可用的握手。 -->
    <string name="agent_probe_start_failed" tools:machine_translated="true">啟動失敗：Agent 未能完成可用的握手。</string>
    <!-- 探測結論：Agent 已回應，但沒有宣告本應用程式需要的協定能力。 -->
    <string name="agent_probe_no_protocol_capability" tools:machine_translated="true">無協定能力：Agent 已回應，但未宣告本應用程式需要的協定能力。</string>
    <!-- 探測結論：探測本身沒有連上主機或沒有取得結果。 -->
    <string name="agent_probe_connect_failed" tools:machine_translated="true">連線失敗：探測未連上主機或未取得探測結果。</string>
    <!-- 探測結論：失敗原因不在已知分類內，原始錯誤另行顯示。 -->
    <string name="agent_probe_unknown_failure" tools:machine_translated="true">探測失敗：原因無法辨識。</string>
    <!-- 探測失敗時清單保持原樣，頂部的「重新整理」是既有重試入口。 -->
    <string name="agent_probe_retry_hint" tools:machine_translated="true">已保留原有會話清單；可用頂部的「重新整理」重試。</string>
    <!-- 該主機的 SSH 連線目前可用。 -->
    <string name="agent_link_connected" tools:machine_translated="true">已連線</string>
    <!-- 連線中斷，退避重連正在進行。 -->
    <string name="agent_link_retrying" tools:machine_translated="true">連線中斷，正在自動重新連線…</string>
    <!-- 需要使用者先處理主機金鑰或憑證才能重連。 -->
    <string name="agent_link_needs_user" tools:machine_translated="true">需要你處理：請重新連線並確認主機金鑰或憑證。</string>
    <!-- 程序重新啟動後沒有即時連線，只能說明上次連線成功的時刻。 -->
    <string name="agent_link_unknown_since" tools:machine_translated="true">狀態未知：上次連線於 %1$s。</string>
    <!-- 已明確斷線，參數為斷線時刻。 -->
    <string name="agent_link_disconnected_since" tools:machine_translated="true">已斷線：%1$s。</string>
    <!-- 上次執行結束時正在自動重連但未成功；參數為次數與時刻。 -->
    <string name="agent_link_retrying_last" tools:machine_translated="true">狀態未知：上次斷線後自動重連未成功（已重試 %1$d 次，%2$s）。</string>
    <!-- 上次執行結束時需要使用者處理；參數為時刻。 -->
    <string name="agent_link_needs_user_last" tools:machine_translated="true">上次需要你處理：%1$s。</string>
    <!-- 讀取 Agent 設定快照時的會話標頭狀態。 -->
    <string name="agent_config_header_loading" tools:machine_translated="true">模型與推理：讀取中…</string>
    <!-- 目前會話後端沒有 ACP 設定能力時的會話標頭狀態。 -->
    <string name="agent_config_header_unsupported" tools:machine_translated="true">模型與推理：不支援</string>
    <!-- 沒有開啟會話時的會話標頭狀態。 -->
    <string name="agent_config_header_closed" tools:machine_translated="true">模型與推理：會話不可用</string>
    <!-- 讀取設定失敗後的標頭入口；點擊開啟面板查看原因。 -->
    <string name="agent_config_header_failed" tools:machine_translated="true">模型與推理：讀取失敗</string>
    <!-- 標頭摘要：目前模型與推理檔，各自顯示真實值或明確的「不支援」。 -->
    <string name="agent_config_summary" tools:machine_translated="true">模型 %1$s · 推理檔 %2$s</string>
    <!-- Agent 目錄中沒有該角色選項時的顯示。 -->
    <string name="agent_config_unsupported" tools:machine_translated="true">不支援</string>
    <!-- 選項存在，但 Agent 未提供目前值。 -->
    <string name="agent_config_unset" tools:machine_translated="true">未指定</string>
    <!-- 面板標題。 -->
    <string name="agent_config_title" tools:machine_translated="true">模型與推理</string>
    <!-- 快照載入中的面板正文。 -->
    <string name="agent_config_loading" tools:machine_translated="true">正在讀取 Agent 設定…</string>
    <!-- 後端沒有 ACP 設定能力時的面板正文。 -->
    <string name="agent_config_unsupported_body" tools:machine_translated="true">該 Agent 不提供 ACP 設定選項，無法讀取或切換模型與推理檔。</string>
    <!-- 沒有開啟會話時的面板正文。 -->
    <string name="agent_config_closed_body" tools:machine_translated="true">會話未連線，無法讀取設定。</string>
    <!-- 帶具體讀取失敗原因的面板錯誤。 -->
    <string name="agent_config_read_failed" tools:machine_translated="true">讀取設定失敗：%1$s</string>
    <!-- 錯誤沒有訊息時的備用原因。 -->
    <string name="agent_config_reason_unknown" tools:machine_translated="true">原因未知</string>
    <!-- 重試讀取設定。 -->
    <string name="agent_config_retry" tools:machine_translated="true">重試</string>
    <!-- Agent 完全沒有提供設定選項。 -->
    <string name="agent_config_empty" tools:machine_translated="true">該 Agent 未提供可切換的設定項。</string>
    <!-- 選項沒有可選值。 -->
    <string name="agent_config_no_values" tools:machine_translated="true">該選項沒有可切換的值。</string>
    <!-- 選項類型不是本應用可切換的 select 類型；唯讀顯示。 -->
    <string name="agent_config_type_readonly" tools:machine_translated="true">該選項類型不支援切換，僅顯示目前值。</string>
    <!-- 標記面板中目前選取的值。 -->
    <string name="agent_config_current" tools:machine_translated="true">目前</string>
    <!-- 沒有可選值的選項的唯讀目前值。 -->
    <string name="agent_config_current_value" tools:machine_translated="true">目前：%1$s</string>
    <!-- 寫入回執：Agent 傳回的快照已包含請求值。 -->
    <string name="agent_config_write_confirmed" tools:machine_translated="true">已確認</string>
    <!-- 寫入回執：Agent 接受了寫入，但快照仍回報舊值。 -->
    <string name="agent_config_write_next_turn" tools:machine_translated="true">已切換，下一輪生效</string>
    <!-- 寫入回執：寫入已送達，但沒有快照確認。 -->
    <string name="agent_config_write_unconfirmed" tools:machine_translated="true">已送達，未確認</string>
    <!-- 寫入回執：請求失敗，保留原值。 -->
    <string name="agent_config_write_failed" tools:machine_translated="true">切換失敗：%1$s</string>
    <!-- 寫入回執：結果傳回前會話已切換或關閉。 -->
    <string name="agent_config_write_closed" tools:machine_translated="true">會話已切換或關閉，結果未生效</string>
    <!-- 寫入回執：後端沒有設定能力。 -->
    <string name="agent_config_write_unsupported" tools:machine_translated="true">該 Agent 不支援切換</string>
    <!-- 面板正在等待 Agent 對所選值的回應。 -->
    <string name="agent_config_writing" tools:machine_translated="true">正在切換…</string>
</resources>
