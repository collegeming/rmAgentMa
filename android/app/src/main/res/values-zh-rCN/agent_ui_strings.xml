    <string name="agent_probe_not_installed" tools:machine_translated="true">未安装：主机上找不到该 Agent 的运行文件。</string>
    <!-- 探测结论：找到了 Agent，但它未能完成可用的握手。 -->
    <string name="agent_probe_start_failed" tools:machine_translated="true">启动失败：Agent 未能完成可用的握手。</string>
    <!-- 探测结论：Agent 应答了，但没有声明本应用需要的协议能力。 -->
    <string name="agent_probe_no_protocol_capability" tools:machine_translated="true">无协议能力：Agent 已应答，但未声明本应用需要的协议能力。</string>
    <!-- 探测结论：探测本身没有连上主机或没有拿到结果。 -->
    <string name="agent_probe_connect_failed" tools:machine_translated="true">连接失败：探测未连上主机或未取得探测结果。</string>
    <!-- 探测结论：失败原因不在已知分类内，原始错误另行显示。 -->
    <string name="agent_probe_unknown_failure" tools:machine_translated="true">探测失败：原因无法识别。</string>
    <!-- 探测失败时列表保持原样，顶栏“刷新”是既有重试入口。 -->
    <string name="agent_probe_retry_hint" tools:machine_translated="true">已保留原有会话列表；可用顶部的“刷新”重试。</string>
    <!-- 该主机的 SSH 连接当前可用。 -->
    <string name="agent_link_connected" tools:machine_translated="true">已连接</string>
    <!-- 连接中断，退避重连正在进行。 -->
    <string name="agent_link_retrying" tools:machine_translated="true">连接中断，正在自动重连…</string>
    <!-- 需要用户先处理主机密钥或凭据才能重连。 -->
    <string name="agent_link_needs_user" tools:machine_translated="true">需要你处理：请重新连接并确认主机密钥或凭据。</string>
    <!-- 进程重启后没有实时连接，只能说明上次连接成功的时刻。 -->
    <string name="agent_link_unknown_since" tools:machine_translated="true">状态未知：上次连接于 %1$s。</string>
    <!-- 已明确断开，参数为断开时刻。 -->
    <string name="agent_link_disconnected_since" tools:machine_translated="true">已断开：%1$s。</string>
    <!-- 上次运行结束时正在自动重连但未成功；参数为次数与时刻。 -->
    <string name="agent_link_retrying_last" tools:machine_translated="true">状态未知：上次断开后自动重连未成功（已重试 %1$d 次，%2$s）。</string>
    <!-- 上次运行结束时需要用户处理；参数为时刻。 -->
    <string name="agent_link_needs_user_last" tools:machine_translated="true">上次需要你处理：%1$s。</string>
</resources>
