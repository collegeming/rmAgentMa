<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Title of the native chat shell before a conversation is selected. -->
    <string name="agent_title">rmAgentMa</string>
    <!-- Back navigation from the chat shell. -->
    <string name="agent_back">返回</string>
    <!-- Refresh remote session lists. -->
    <string name="agent_refresh">刷新</string>
    <!-- Create a new remote agent conversation. -->
    <string name="agent_new">新建会话</string>
    <!-- Disconnect all agent SSH connections. -->
    <string name="agent_disconnect">断开所有 Agent</string>
    <!-- Confirmation warning before disconnecting agent connections. -->
    <string name="agent_disconnect_warning">断开所有 Agent 连接？正在进行的对话可能会中断。</string>
    <!-- Generic confirmation action. -->
    <string name="agent_confirm">确认</string>
    <!-- Dismiss a dialog or cancel an operation. -->
    <string name="agent_cancel">取消</string>
    <!-- Device filter label. -->
    <string name="agent_device">主机</string>
    <!-- Agent filter and new session label. -->
    <string name="agent_kind">Agent</string>
    <!-- All devices or agent kinds in a filter. -->
    <string name="agent_all">全部</string>
    <!-- Drawer search across session titles, message previews and working directories. -->
    <string name="agent_search">搜索标题、消息或目录</string>
    <!-- Explain absence of saved SSH devices. -->
    <string name="agent_no_devices">请先在主机列表中添加 SSH 主机。</string>
    <!-- Empty or filtered session list. -->
    <string name="agent_no_sessions">没有匹配的会话。刷新以读取远端历史，或新建会话。</string>
    <!-- Search range of one pass: rows re-read from the remote and rows known only from the cached index. -->
    <string name="agent_search_scope">范围：远端已加载 %1$d 条，仅缓存 %2$d 条</string>
    <!-- A search could not cover every source; the argument carries the concrete reasons. -->
    <string name="agent_search_incomplete">结果可能不完整：%1$s</string>
    <!-- Reason for an incomplete search: a host/agent list filled one scan page, so older history may be missing. -->
    <string name="agent_search_unloaded_pages">该 Agent 的会话列表已达到单次扫描上限（%1$d 条），可能还有未加载的历史。</string>
    <!-- Reason for an incomplete search: these host/agent sources failed, so their rows stay cache-only. -->
    <string name="agent_search_failed_sources">这些来源本轮未读取成功：%1$s</string>
    <!-- Retry keeps the existing entry point, the top-bar refresh; the drawer adds no second loading entry. -->
    <string name="agent_search_retry_hint">已保留已得结果；可用顶部的“刷新”重试。</string>
    <!-- A hit matched the title of the session. -->
    <string name="agent_search_field_title">命中：标题</string>
    <!-- A hit matched the message preview shown for the session. -->
    <string name="agent_search_field_preview">命中：内容</string>
    <!-- A hit matched the working directory of the session. -->
    <string name="agent_search_field_cwd">命中：目录</string>
    <!-- The hit was re-read from the remote host in the last pass. -->
    <string name="agent_search_source_remote">远端</string>
    <!-- The hit is known only from the cached index, not from a remote read in this run. -->
    <string name="agent_search_source_cached">仅缓存</string>
    <!-- Historical sessions remain visible when disconnected. -->
    <string name="agent_cache_hint">历史记录可能来自缓存。刷新需要连接；出现错误并不表示缓存中的会话在线可用。</string>
    <!-- Native driver support is distinct from availability on a particular host. -->
    <string name="agent_support_hint">原生对话集成支持 Kimi、OpenCode、oh-my-pi、deepseek-harness 和 zcode。每台主机的安装情况与能力需单独验证。</string>
    <!-- Continue a supported native session. -->
    <string name="agent_continue">继续</string>
    <!-- Open a session in the existing SSH terminal. -->
    <string name="agent_terminal">终端</string>
    <!-- Label for agents which are terminal-only. -->
    <string name="agent_terminal_only">仅终端</string>
    <!-- Missing host referenced by a cached session. -->
    <string name="agent_missing_host">主机不可用</string>
    <!-- Empty native title uses the session identifier. -->
    <string name="agent_untitled">未命名会话</string>
    <!-- Session metadata: agent, host and working directory are displayed separately. -->
    <string name="agent_updated">更新于：%1$s</string>
    <!-- New session absolute remote working directory field. -->
    <string name="agent_cwd">绝对工作目录</string>
    <!-- Working directory validation error. -->
    <string name="agent_cwd_error">请使用以 / 开头的绝对 Linux/WSL 路径，且不含控制字符。</string>
    <!-- Button creating either a structured or terminal session. -->
    <string name="agent_start">开始</string>
    <!-- Missing local-network permission; no remote refresh is attempted. -->
    <string name="agent_network_denied">在 Android 16 及更高版本上，本地网络连接需要“附近的设备”权限。未发起任何网络请求。请在系统设置中授予权限，或重试。</string>
    <!-- Action explicitly retrying the runtime permission request. -->
    <string name="agent_network_retry">允许本地网络访问</string>
    <!-- One-time notice that a host moved to a new LAN address which was accepted only after the SSH host key matched; arguments are the previous and the accepted address. -->
    <string name="agent_host_address_updated">已自动更新主机地址：%1$s → %2$s（主机指纹已确认）</string>
    <!-- Dismisses the automatic host address notice. -->
    <string name="agent_host_address_dismiss">知道了</string>
    <!-- Message input label in a conversation. -->
    <string name="agent_prompt">消息</string>
    <!-- Submit a prompt or free-text answer. -->
    <string name="agent_send">发送</string>
    <!-- Cancel the currently running agent turn. -->
    <string name="agent_stop">停止</string>
    <!-- Empty conversation instructions. -->
    <string name="agent_conversation_empty">发送消息即可开始。回复、工具和批准请求会显示在这里。</string>
    <!-- User message heading. -->
    <string name="agent_event_user">你</string>
    <!-- Assistant content heading. -->
    <string name="agent_event_content">助手</string>
    <!-- Collapsible reasoning heading. -->
    <string name="agent_event_thinking">思考</string>
    <!-- Tool event heading. -->
    <string name="agent_event_tool">工具</string>
    <!-- Plan event heading. -->
    <string name="agent_event_plan">计划</string>
    <!-- Permission event heading. -->
    <string name="agent_event_permission">需要权限</string>
    <!-- Question event heading. -->
    <string name="agent_event_question">提问</string>
    <!-- Token/context event heading. -->
    <string name="agent_event_usage">用量</string>
    <!-- Native session information heading. -->
    <string name="agent_event_session">会话信息</string>
    <!-- Completed turn event heading. -->
    <string name="agent_event_complete">本轮完成</string>
    <!-- Remote error heading. -->
    <string name="agent_event_error">Agent 错误</string>
    <!-- Unknown protocol event heading. -->
    <string name="agent_event_unknown">无法识别的事件</string>
    <!-- Raw event disclosure. -->
    <string name="agent_raw">原始事件 / 输入 / 输出</string>
    <!-- File diff section heading. -->
    <string name="agent_diff">文件改动</string>
    <!-- Free-form answer to an agent question. -->
    <string name="agent_answer">你的回答</string>
    <!-- Event that lacks a usable response identifier or options. -->
    <string name="agent_no_response">此事件没有响应标识或可选项。如需交互，请使用终端。</string>
    <!-- An interaction is in flight; only removal by the repository confirms resolution. -->
    <string name="agent_response_pending">正在发送响应…</string>
    <!-- Host-key verification dialog title; host is shown in body. -->
    <string name="agent_host_key">验证主机指纹</string>
    <!-- Password authentication dialog title. -->
    <string name="agent_password">SSH 密码</string>
    <!-- Private-key passphrase authentication dialog title. -->
    <string name="agent_passphrase">私钥密码短语</string>
    <!-- Fallback title for an authentication challenge. -->
    <string name="agent_auth">SSH 身份验证</string>
    <!-- Explicitly approve a presented SSH host fingerprint. -->
    <string name="agent_accept">接受指纹</string>
    <!-- Explicitly reject a presented SSH host fingerprint. -->
    <string name="agent_reject">拒绝</string>
    <!-- Secret input label for SSH authentication. -->
    <string name="agent_secret">密码或密码短语</string>
    <!-- Unknown authentication challenge must not be accepted implicitly. -->
    <string name="agent_unknown_challenge">不支持的身份验证请求。请取消并使用终端。</string>
    <!-- Display name for Kimi Code. -->
    <string name="agent_name_kimi">Kimi Code</string>
    <!-- Display name for OpenCode. -->
    <string name="agent_name_opencode">OpenCode</string>
    <!-- Display name for oh-my-pi. -->
    <string name="agent_name_omp">oh-my-pi</string>
    <!-- Display name for deepseek-harness. -->
    <string name="agent_name_dsh">deepseek-harness</string>
    <!-- Display name for zcode. -->
    <string name="agent_name_zcode">zcode</string>
    <!-- Plan entry priority and execution status, using values supplied by the agent. -->
    <string name="agent_plan_priority">优先级：%1$s</string>
    <!-- Plan entry execution status. -->
    <string name="agent_plan_status">状态：%1$s</string>
    <!-- ACP plan updates are notifications, not approval requests. -->
    <string name="agent_plan_notice">此计划是更新通知，不是批准请求。仅在出现权限请求时才需要批准。</string>
    <!-- Context use reported by the agent, without inferred token counts. -->
    <string name="agent_usage_used">已用上下文：%1$s</string>
    <!-- Context capacity reported by the agent. -->
    <string name="agent_usage_size">上下文容量：%1$s</string>
    <!-- Monetary cost as reported by the agent. -->
    <string name="agent_usage_cost">费用：%1$s</string>
    <!-- Native session title supplied by a session information event. -->
    <string name="agent_info_title">标题：%1$s</string>
    <!-- Native creation timestamp; display its actual representation. -->
    <string name="agent_info_created">创建于：%1$s</string>
    <!-- Native last-update timestamp; display its actual representation. -->
    <string name="agent_info_updated">更新于：%1$s</string>
    <!-- Collapsible tool input section. -->
    <string name="agent_tool_input">工具输入</string>
    <!-- Collapsible tool output section. -->
    <string name="agent_tool_output">工具输出</string>
    <!-- Collapsible tool content and result blocks. -->
    <string name="agent_tool_content">工具结果内容</string>
    <!-- Visible warning when transport or history truncated an event. -->
    <string name="agent_truncated">此事件已被截断，部分细节缺失；请在终端中查看远端会话以获取完整结果。</string>
    <!-- Describe a schema field and its primitive type. -->
    <string name="agent_question_field">%1$s（%2$s）</string>
    <!-- Marker for a required schema field. -->
    <string name="agent_question_required">必填</string>
    <!-- Free JSON input for forms with more than one field or non-string fields. -->
    <string name="agent_question_json">以 JSON 对象作答</string>
    <!-- Explain the exact multi-field answer format; no guessed values are inserted. -->
    <string name="agent_question_json_hint">请将上方的字段名用作 JSON 键。类型需要匹配，并包含必填字段。布尔值和数字不要加引号。</string>
    <!-- Invalid or incomplete schema answer; submission remains disabled. -->
    <string name="agent_question_invalid">回答与请求的字段、类型或允许值不匹配。</string>
    <!-- Schema was absent or too complex for a safe phone form. -->
    <string name="agent_question_unsupported">没有可用的问题结构。请查看原始详情或使用终端。</string>
    <!-- Opens the per-session detail sheet that aggregates plan, changes, commands, tests, tools and usage. -->
    <string name="agent_details">详情</string>
    <!-- Title of the per-session detail sheet; arguments are the workspace label and working directory. -->
    <string name="agent_details_title">会话详情 · %1$s</string>
    <!-- Detail sheet tab listing the plan entries reported by the agent. -->
    <string name="agent_details_tab_plan">计划</string>
    <!-- Detail sheet tab listing file changes reported by tool calls. -->
    <string name="agent_details_tab_changes">改动</string>
    <!-- Detail sheet tab listing executed commands and their latest reported output. -->
    <string name="agent_details_tab_commands">命令</string>
    <!-- Detail sheet tab listing test runs, tool calls and usage reported by the agent. -->
    <string name="agent_details_tab_tools">工具</string>
    <!-- Placeholder when a detail section has no reported entries. -->
    <string name="agent_details_empty">已加载的事件中还没有此类记录。</string>
    <!-- Reminder that the detail sheet covers the loaded history window only. -->
    <string name="agent_details_window">“详情”只汇总当前已加载的事件窗口；更早的记录需要先加载更早的消息。</string>
    <!-- Reminder that the loaded history window does not hold every earlier record. -->
    <string name="agent_details_earlier_notice">还有更早的记录未加载，下方汇总可能并不完整。</string>
    <!-- Summary of one file change; arguments are the file path, added lines and removed lines. -->
    <string name="agent_details_file_stats">%1$s · +%2$d / -%3$d</string>
    <!-- Plan progress summary; arguments are completed entries and total entries. -->
    <string name="agent_details_plan_progress">已完成 %1$d / %2$d</string>
    <!-- Plan status values are supplied by the agent. -->
    <string name="agent_details_plan_status">%1$s</string>
    <!-- A file was changed without a countable diff. -->
    <string name="agent_details_file_reported">已报告改动，未附带可计数的差异。</string>
    <!-- A tool call reported no structured detail. -->
    <string name="agent_details_no_detail">没有结构化细节。</string>
    <!-- Expands the captured diff of one file change. -->
    <string name="agent_details_show_diff">查看差异</string>
    <!-- Collapses the captured diff of one file change. -->
    <string name="agent_details_hide_diff">收起差异</string>
    <!-- Section of commands observed in tool calls. -->
    <string name="agent_details_commands">命令记录</string>
    <!-- Section of test runs recognized by their command or reported output. -->
    <string name="agent_details_tests">测试结果</string>
    <!-- Test run heading; the value is the agent-reported status string. -->
    <string name="agent_details_test_status">测试状态：%1$s</string>
    <!-- Section of usage and context records. -->
    <string name="agent_details_usage">用量</string>
    <!-- Read-only summary of approval requests; the count is the number of requests in the loaded window. -->
    <string name="agent_details_approvals">审批记录（只读）· %1$d</string>
    <!-- Explains that approval history shown here cannot be acted on. -->
    <string name="agent_details_approvals_readonly">历史记录仅供查看，不能在这里批准；只有聊天中当前会话的请求可以批准。</string>
    <!-- Explains that an approval request is still awaiting a response in the chat stream. -->
    <string name="agent_details_approval_pending">等待在聊天中批准。</string>
    <!-- Explains that an approval record no longer accepts a response. -->
    <string name="agent_details_approval_history">历史审批记录，不再接受响应。</string>
    <!-- Session view switch: the structured conversation. -->
    <string name="agent_view_chat">聊天</string>
    <!-- Session view switch: the agent's own interactive terminal interface. -->
    <string name="agent_view_tui">TUI</string>
    <!-- Explains that the TUI runs as its own SSH session in the terminal. -->
    <string name="agent_tui_notice">TUI 会以独立的 SSH 会话在终端中打开，使用本会话的 Agent 与工作目录。</string>
    <!-- Warnings that the ACP process of this conversation may keep the same session open. -->
    <string name="agent_tui_share_warning">本对话当前由 ACP 进程占用同一会话 ID。同一会话上 ACP 与交互式 TUI 能否并发尚未验证；如 TUI 无法打开，请先关闭对话再试。</string>
    <!-- Label of the exact shell command that opens the interactive TUI. -->
    <string name="agent_tui_command">命令</string>
    <!-- Action that opens the terminal and sends the TUI command. -->
    <string name="agent_tui_open">打开终端</string>
    <!-- Explains that an SSH host is required before the TUI can be opened. -->
    <string name="agent_tui_no_host">此会话所属主机不可用，无法打开终端。</string>
    <!-- Explains that the working directory cannot be used as a terminal argument. -->
    <string name="agent_tui_bad_cwd">此会话的工作目录不可用，拒绝拼接终端命令。</string>
    <!-- Probe is still running: the previous verdict is not shown until the new one arrives. -->
    <string name="agent_probe_refreshing">正在探测…</string>
    <!-- Probe verdict: the host holds no installation of this Agent. -->
    <string name="agent_probe_not_installed">未安装：主机上找不到该 Agent 的运行文件。</string>
    <!-- Probe verdict: the Agent exists but never completed a usable handshake. -->
    <string name="agent_probe_start_failed">启动失败：Agent 未能完成可用的握手。</string>
    <!-- Probe verdict: the Agent answered without declaring the protocol capabilities this app requires. -->
    <string name="agent_probe_no_protocol_capability">无协议能力：Agent 已应答，但未声明本应用需要的协议能力。</string>
    <!-- Probe verdict: the probe itself never reached the host or produced a result. -->
    <string name="agent_probe_connect_failed">连接失败：探测未连上主机或未取得探测结果。</string>
    <!-- Probe verdict: the failure is outside the known categories; the raw error is shown separately. -->
    <string name="agent_probe_unknown_failure">探测失败：原因无法识别。</string>
    <!-- A failed probe keeps the session list; the top bar refresh remains the existing retry entry. -->
    <string name="agent_probe_retry_hint">已保留原有会话列表；可用顶部的“刷新”重试。</string>
    <!-- The SSH link of this host is up right now. -->
    <string name="agent_link_connected">已连接</string>
    <!-- The link dropped and the backoff reconnect is running. -->
    <string name="agent_link_retrying">连接中断，正在自动重连…</string>
    <!-- Host key or credentials need the user before reconnecting. -->
    <string name="agent_link_needs_user">需要你处理：请重新连接并确认主机密钥或凭据。</string>
    <!-- After a process restart there is no live link, so only the last successful connect time is known. -->
    <string name="agent_link_unknown_since">状态未知：上次连接于 %1$s。</string>
    <!-- The link was torn down explicitly; the argument is the teardown time. -->
    <string name="agent_link_disconnected_since">已断开：%1$s。</string>
    <!-- The last run ended while reconnecting without success; arguments are the attempt count and the time. -->
    <string name="agent_link_retrying_last">状态未知：上次断开后自动重连未成功（已重试 %1$d 次，%2$s）。</string>
    <!-- The last run ended waiting for the user; the argument is the time. -->
    <string name="agent_link_needs_user_last">上次需要你处理：%1$s。</string>
</resources>
