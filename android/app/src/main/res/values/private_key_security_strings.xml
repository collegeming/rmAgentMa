<resources>
    <!-- Persistent warning above the SSH key list, including empty and loading states. -->
    <string name="private_key_security_notice">System backups do not include private keys. Before uninstalling, clearing app data, or moving to another device, export your exportable private keys from the key menu. Keep exported files secure, especially files without a passphrase. Biometric keys cannot be exported; arrange another way to sign in before removing this app.</string>
    <!-- Settings toggle for backing up records that already contain only a public key, never private keys. -->
    <string name="private_key_security_backup_public_only_title">Back up public-only key records</string>
    <!-- Explains the limited scope of the public-only key backup toggle; private key exports remain separate. -->
    <string name="private_key_security_backup_public_only_summary">Includes only key records with no private key. Private keys are excluded even when this is on; export them separately before uninstalling, clearing app data, or changing devices.</string>
</resources>
